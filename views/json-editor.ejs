<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>JSON Template Editor - <%= configName %></title>
    <style>
        :root {
            --bg: #0b0c10;
            --bg-soft: #121319;
            --card: #151821;
            --text: #e6e8ee;
            --muted: #aab0bd;
            --accent: #6ad1ff;
            --accent-2: #9bffb7;
            --shadow: 0 10px 30px rgba(0,0,0,.35);
            --radius: 12px;
        }
        
        * { box-sizing: border-box; }
        
        body {
            margin: 0;
            padding: 20px;
            background: var(--bg);
            color: var(--text);
            font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            line-height: 1.6;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            height: calc(100vh - 40px);
        }
        
        .panel {
            background: var(--card);
            border-radius: var(--radius);
            padding: 20px;
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
        }
        
        h1, h2 {
            margin: 0 0 16px;
            color: var(--accent);
        }
        
        .editor-wrapper {
            flex: 1;
            position: relative;
        }
        
        #jsonEditor {
            width: 100%;
            height: 100%;
            background: var(--bg-soft);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            color: var(--text);
            font-family: 'Consolas', 'Monaco', monospace;
            font-size: 14px;
            line-height: 1.4;
            padding: 16px;
            resize: none;
            outline: none;
        }
        
        #jsonEditor:focus {
            border-color: var(--accent);
        }
        
        .controls {
            display: flex;
            gap: 12px;
            margin-bottom: 16px;
            align-items: center;
        }
        
        .btn {
            background: var(--accent);
            color: var(--bg);
            border: none;
            padding: 10px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.2s ease;
        }
        
        .btn:hover {
            background: var(--accent-2);
            transform: translateY(-1px);
        }
        
        .btn.secondary {
            background: var(--bg-soft);
            color: var(--text);
            border: 1px solid rgba(255,255,255,0.2);
        }
        
        .status {
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 16px;
            font-weight: 500;
        }
        
        .status.success {
            background: rgba(124,242,198,.15);
            border: 1px solid rgba(124,242,198,.5);
            color: #00c58e;
        }
        
        .status.error {
            background: rgba(255,106,138,.15);
            border: 1px solid rgba(255,106,138,.5);
            color: #ff6a8a;
        }
        
        .preview-frame {
            flex: 1;
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            background: white;
        }
        
        .config-info {
            background: var(--bg-soft);
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 16px;
            font-size: 14px;
            color: var(--muted);
        }
        
        @media (max-width: 768px) {
            .container {
                grid-template-columns: 1fr;
                gap: 16px;
            }
            
            .controls {
                flex-wrap: wrap;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- JSON Editor Panel -->
        <div class="panel">
            <h2>JSON Editor - <%= configName %></h2>
            
            <div class="config-info">
                設定名: <strong><%= configName %></strong><br>
                JSONを編集してテンプレートをカスタマイズできます
            </div>
            
            <div class="controls">
                <button id="saveBtn" class="btn">💾 保存</button>
                <button id="previewBtn" class="btn secondary">👁️ プレビュー更新</button>
                <button id="validateBtn" class="btn secondary">✅ JSON検証</button>
                <button id="formatBtn" class="btn secondary">🎨 整形</button>
            </div>
            
            <div id="status" class="status" style="display: none;"></div>
            
            <div class="editor-wrapper">
                <textarea id="jsonEditor" placeholder="JSON設定を入力してください..."><%= configJson %></textarea>
            </div>
        </div>
        
        <!-- Preview Panel -->
        <div class="panel">
            <h2>プレビュー</h2>
            <div class="controls">
                <button id="openNewTab" class="btn secondary">🔗 新しいタブで開く</button>
            </div>
            <iframe id="preview" class="preview-frame" src="/template/<%= configName %>"></iframe>
        </div>
    </div>

    <script>
        const jsonEditor = document.getElementById('jsonEditor');
        const saveBtn = document.getElementById('saveBtn');
        const previewBtn = document.getElementById('previewBtn');
        const validateBtn = document.getElementById('validateBtn');
        const formatBtn = document.getElementById('formatBtn');
        const preview = document.getElementById('preview');
        const status = document.getElementById('status');
        const openNewTab = document.getElementById('openNewTab');
        
        const configName = '<%= configName %>';
        
        function showStatus(message, type = 'success') {
            status.textContent = message;
            status.className = `status ${type}`;
            status.style.display = 'block';
            
            setTimeout(() => {
                status.style.display = 'none';
            }, 3000);
        }
        
        function validateJSON() {
            try {
                const json = jsonEditor.value;
                JSON.parse(json);
                showStatus('JSONは有効です', 'success');
                return true;
            } catch (error) {
                showStatus('JSON構文エラー: ' + error.message, 'error');
                return false;
            }
        }
        
        function formatJSON() {
            try {
                const json = jsonEditor.value;
                const parsed = JSON.parse(json);
                jsonEditor.value = JSON.stringify(parsed, null, 2);
                showStatus('JSON整形完了', 'success');
            } catch (error) {
                showStatus('JSON整形失敗: ' + error.message, 'error');
            }
        }
        
        function updatePreview() {
            preview.src = `/template/${configName}?t=${Date.now()}`;
            showStatus('プレビュー更新完了', 'success');
        }
        
        async function saveConfig() {
            if (!validateJSON()) return;
            
            try {
                saveBtn.textContent = '保存中...';
                saveBtn.disabled = true;
                
                const response = await fetch(`/api/save-config/${configName}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        config: jsonEditor.value
                    })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showStatus('設定を保存しました', 'success');
                    updatePreview();
                } else {
                    showStatus('保存エラー: ' + result.error, 'error');
                }
            } catch (error) {
                showStatus('保存エラー: ' + error.message, 'error');
            } finally {
                saveBtn.textContent = '💾 保存';
                saveBtn.disabled = false;
            }
        }
        
        // Event Listeners
        saveBtn.addEventListener('click', saveConfig);
        previewBtn.addEventListener('click', updatePreview);
        validateBtn.addEventListener('click', validateJSON);
        formatBtn.addEventListener('click', formatJSON);
        
        openNewTab.addEventListener('click', () => {
            window.open(`/template/${configName}`, '_blank');
        });
        
        // Keyboard shortcuts
        jsonEditor.addEventListener('keydown', (e) => {
            if (e.ctrlKey && e.key === 's') {
                e.preventDefault();
                saveConfig();
            }
            
            if (e.ctrlKey && e.key === 'Enter') {
                e.preventDefault();
                updatePreview();
            }
        });
        
        // Auto-save on Ctrl+S
        document.addEventListener('keydown', (e) => {
            if (e.ctrlKey && e.key === 's') {
                e.preventDefault();
                saveConfig();
            }
        });
    </script>
</body>
</html>