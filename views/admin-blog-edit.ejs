<!-- views/admin-blog-edit.ejs -->
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ブログ編集 <%= blogId %></title>
<style>
  body{font-family:system-ui;margin:24px}
  .row{display:flex;gap:16px;align-items:center;margin:8px 0;flex-wrap:wrap}
  textarea{width:100%;height:55vh;font-family:ui-monospace,monospace}
  .grid{display:grid;grid-template-columns:1fr 380px;gap:16px}
  @media (max-width: 900px){ .grid{grid-template-columns:1fr} textarea{height:40vh} }
  .card{border:1px solid #e5e7eb;border-radius:12px;padding:12px}
  label{display:flex;flex-direction:column;gap:6px}
  .muted{opacity:.7;font-size:12px}
  .actions{display:flex;gap:8px}
</style>
</head>
<body>
  <h1>ブログ編集: <code><%= blogId %></code></h1>

  <div class="card" id="authCard" style="background:#fef3c7;border-color:#f59e0b;margin-bottom:16px">
    <div class="row">
      <label>編集ID: <input type="password" id="authId" placeholder="編集IDを入力してください"></label>
      <button type="button" id="authBtn">認証</button>
    </div>
    <div class="muted">正しい編集IDを入力してください</div>
  </div>

  <div id="mainContent" style="display:none">
    <form id="form" method="POST" action="/admin/blogs/<%= blogId %>">
      <div class="grid">
        <div class="card">
          <div class="row">
            <label>タイトル <input name="title" value="<%= doc.title || '' %>"></label>
            <label>スラッグ <input name="slug" value="<%= doc.slug || '' %>"></label>
          </div>
          <div class="row">
            <label>抜粋 <input name="excerpt" value="<%= doc.excerpt || '' %>"></label>
            <label>著者 <input name="author" value="<%= doc.author || '' %>"></label>
          </div>

          <div class="row">
            <label>カテゴリ
              <select name="category">
                <option value="">未分類</option>
                <option value="Gear" <%= doc.category==='Gear' ? 'selected' : '' %>>Gear</option>
                <option value="Review" <%= doc.category==='Review' ? 'selected' : '' %>>Review</option>
                <option value="Training" <%= doc.category==='Training' ? 'selected' : '' %>>Training</option>
                <option value="Nutrition" <%= doc.category==='Nutrition' ? 'selected' : '' %>>Nutrition</option>
                <option value="Event" <%= doc.category==='Event' ? 'selected' : '' %>>Event</option>
                <option value="Other" <%= doc.category==='Other' ? 'selected' : '' %>>Other</option>
              </select>
            </label>
            <label style="align-self:flex-end"><input type="checkbox" name="isDraft" <%= doc.isDraft ? 'checked' : '' %>> 下書きにする</label>
          </div>

          <div style="margin-top:10px">
            <textarea id="editor" name="html"><%= doc.html || '' %></textarea>
          </div>

          <div style="margin-top:10px" class="actions">
            <button id="saveBtn" type="submit">保存</button>
            <button id="previewBtn" type="button">プレビュー</button>
          </div>
          <div class="muted">最後に保存: <span id="savedAt">未保存</span></div>
        </div>

        <aside class="card">
          <div class="row"><strong>画像アップロード</strong></div>
          <div id="dropZone" style="border:1px dashed #cbd5e1;border-radius:12px;padding:16px;text-align:center">ここに画像をドロップ</div>
          <input id="fileInput" type="file" accept="image/*" hidden>
          <div id="uploadMsg" class="muted"></div>

          <hr>
          <div><strong>プレビュー</strong></div>
          <div id="preview" style="min-height:200px"></div>
        </aside>
      </div>
    </form>
  </div>

<script>
  // 簡易認証
  const EDIT_ID = 'mypassword123';
  document.getElementById('authBtn').addEventListener('click', ()=>{
    const val = document.getElementById('authId').value;
    if(val === EDIT_ID){ document.getElementById('authCard').style.display='none'; document.getElementById('mainContent').style.display='block'; }
    else { alert('編集IDが正しくありません'); }
  });

  // エディタ・プレビュー
  const ed = document.getElementById('editor');
  const pv = document.getElementById('preview');
  function render(){ pv.innerHTML = ed.value; }
  ed && ed.addEventListener('input', render);
  render();

  // Drag & drop 画像アップロード
  const dz = document.getElementById('dropZone');
  const fileInput = document.getElementById('fileInput');
  const uploadMsg = document.getElementById('uploadMsg');
  const blogId = '<%= blogId %>';
  fileInput.onchange = ()=> handleFiles(fileInput.files);
  dz.addEventListener('dragover', e=>{ e.preventDefault(); dz.style.background='#f8fafc'; });
  dz.addEventListener('dragleave', ()=> dz.style.background='transparent');
  dz.addEventListener('drop', e=>{ e.preventDefault(); dz.style.background='transparent'; handleFiles(e.dataTransfer.files); });

  async function handleFiles(files){
    const file = files[0]; if(!file) return;
    const fd = new FormData(); fd.append('image', file);
    uploadMsg.textContent = 'アップロード中...';
    try{
      const res = await fetch(`/admin/blogs/${encodeURIComponent(blogId)}/image`, { method: 'POST', body: fd });
      const data = await res.json();
      if(!res.ok || !data.url) throw new Error(data.msg || 'upload failed');
      uploadMsg.textContent = '挿入しました：' + data.url;
      // エディタに挿入
      const tag = `\n<img src="${data.url}" alt="" loading="lazy">\n`;
      const start = ed.selectionStart || 0; const v = ed.value; ed.value = v.slice(0,start)+tag+v.slice(start);
      render();
    }catch(err){ console.error(err); uploadMsg.textContent = 'アップロード失敗'; }
  }

  // フォーム送信（JSONで送る）
  document.getElementById('form').addEventListener('submit', async (e)=>{
    e.preventDefault();
    const form = e.target;
    const obj = {
      title: form.title.value,
      slug: form.slug.value,
      excerpt: form.excerpt.value,
      author: form.author.value,
      category: form.category.value,
      isDraft: form.isDraft.checked,
      html: form.html.value || form.editor.value
    };
    try{
      const res = await fetch(form.action, { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(obj) });
      const data = await res.json();
      if(res.ok){ document.getElementById('savedAt').textContent = new Date().toLocaleString(); alert('保存しました'); }
      else { alert('保存に失敗しました: '+(data.error||data.msg)); }
    }catch(err){ alert('保存エラー: '+err.message); }
  });
</script>
</body>
</html>
