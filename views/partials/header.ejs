<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title : 'Runnersplac｜ランニングシューズレビュー' %></title>
<% if (typeof description !== 'undefined' && description) { %><meta name="description" content="<%= description %>"><% } %>
<% if (typeof robots !== 'undefined' && robots) { %><meta name="robots" content="<%= robots %>"><% } %>
<% if (typeof req !== 'undefined' && req && !(typeof robots !== 'undefined' && robots && /noindex/.test(robots))) { %><link rel="canonical" href="https://runnersplac.com<%= req.originalUrl.split('?')[0] %>"><% } %>
<meta name="theme-color" content="#0e0d0b">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;800&family=IBM+Plex+Mono:wght@500;600&display=swap">
<link rel="stylesheet" href="/css/base.css">
<link rel="stylesheet" href="/css/site.css">
<link rel="stylesheet" href="/css/prose.css">
<% if (typeof extraCss !== 'undefined') extraCss.forEach(function(href){ %><link rel="stylesheet" href="<%= href %>">
<% }) %>
<meta name="google-site-verification" content="_5czcBL4tvbzQxBywCtZMynFRJHnP9ddVkyZN0i2zsI" />
</head>
<body>
<nav class="nav">
  <div class="container nav-inner">
    <a class="site-brand" href="/">RUNNERSPLAC</a>
    <div class="nav-actions">
<% if (typeof user !== 'undefined' && user) { %>
      <a class="nav-login" href="/logout">ログアウト</a>
<% } else { %>
      <a class="nav-login" href="/login" aria-current="<%= current==='login' ? 'page' : 'false' %>">ログイン</a>
<% } %>
      <details class="nav-menu">
        <summary aria-label="メニューを開く">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          <span>メニュー</span>
        </summary>
        <div class="nav-menu__panel">
          <a href="/home2" aria-current="<%= current==='home' ? 'page' : 'false' %>">シューズ</a>
          <a href="/compare" aria-current="<%= current==='compare' ? 'page' : 'false' %>">シューズ比較</a>
          <a href="/lab" aria-current="<%= current==='lab' ? 'page' : 'false' %>">シューズ実験室</a>
          <a href="/protein" aria-current="<%= current==='protein' ? 'page' : 'false' %>">プロテイン</a>
          <a href="/clinic" aria-current="<%= current==='clinic' ? 'page' : 'false' %>">治療院</a>
          <a href="/blog" aria-current="<%= current==='blog' ? 'page' : 'false' %>">ブログ</a>
          <a href="/wishlist" aria-current="<%= current==='wishlist' ? 'page' : 'false' %>">購入候補</a>
        </div>
      </details>
    </div>
    <script>
      // メニューの外を押したら閉じる
      document.addEventListener('click', function (e) {
        document.querySelectorAll('.nav-menu[open]').forEach(function (m) { if (!m.contains(e.target)) m.removeAttribute('open'); });
      });
    </script>
  </div>
</nav>
