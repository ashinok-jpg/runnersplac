<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Markdown エディタ - <%= shoeId %></title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans+JP:wght@300;400;500;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-main: #0f172a;
            --bg-card: #1e293b;
            --bg-editor: #0b1329;
            --border-color: #334155;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent: #6366f1;
            --accent-hover: #4f46e5;
            --accent-success: #10b981;
            --accent-error: #ef4444;
            --shadow: 0 10px 25px -5px rgba(0,0,0,0.3), 0 8px 10px -6px rgba(0,0,0,0.3);
            --font-sans: 'Inter', 'Noto Sans JP', sans-serif;
            --font-mono: 'Fira Code', 'Consolas', monospace;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            font-family: var(--font-sans);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* ヘッダー */
        header {
            background-color: var(--bg-card);
            border-bottom: 1px solid var(--border-color);
            padding: 12px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 64px;
            z-index: 10;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        .header-title-area {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .header-title-area h1 {
            font-size: 1.25rem;
            font-weight: 600;
            letter-spacing: -0.025em;
        }

        .file-badge {
            background-color: rgba(99, 102, 241, 0.15);
            border: 1px solid rgba(99, 102, 241, 0.3);
            color: #818cf8;
            padding: 4px 10px;
            border-radius: 6px;
            font-family: var(--font-mono);
            font-size: 0.8rem;
        }

        .source-badge {
            background-color: rgba(148, 163, 184, 0.1);
            border: 1px solid rgba(148, 163, 184, 0.2);
            color: var(--text-muted);
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 0.75rem;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        /* ボタン */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: 500;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            border: none;
            text-decoration: none;
            outline: none;
        }

        .btn-primary {
            background-color: var(--accent);
            color: white;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        }

        .btn-primary:hover {
            background-color: var(--accent-hover);
            transform: translateY(-1px);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        .btn-secondary {
            background-color: transparent;
            color: var(--text-main);
            border: 1px solid var(--border-color);
        }

        .btn-secondary:hover {
            background-color: rgba(255, 255, 255, 0.05);
            border-color: var(--text-muted);
        }

        /* メインコンテナ（左右分割） */
        .main-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            flex: 1;
            overflow: hidden;
            background-color: var(--bg-main);
        }

        /* 左側：エディターペイン */
        .editor-pane {
            display: flex;
            flex-direction: column;
            border-right: 1px solid var(--border-color);
            position: relative;
            height: 100%;
        }

        .editor-header {
            background-color: rgba(30, 41, 59, 0.4);
            padding: 8px 16px;
            font-size: 0.8rem;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
        }

        .editor-container {
            flex: 1;
            position: relative;
            overflow: hidden;
        }

        textarea#markdownEditor {
            width: 100%;
            height: 100%;
            border: none;
            background-color: var(--bg-editor);
            color: #e2e8f0;
            font-family: var(--font-mono);
            font-size: 15px;
            line-height: 1.6;
            padding: 24px;
            resize: none;
            outline: none;
            tab-size: 4;
            overflow-y: auto;
        }

        /* 右側：プレビューペイン */
        .preview-pane {
            display: flex;
            flex-direction: column;
            background-color: #f8fafc; /* 公開ページと同じ背景色 */
            height: 100%;
        }

        .preview-header {
            background-color: var(--bg-card);
            border-bottom: 1px solid var(--border-color);
            padding: 8px 16px;
            font-size: 0.8rem;
            color: var(--text-muted);
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 38px;
        }

        .preview-iframe {
            flex: 1;
            width: 100%;
            border: none;
            background-color: white;
        }

        /* トースト通知 */
        .toast {
            position: fixed;
            bottom: 24px;
            left: 24px;
            background-color: var(--accent-success);
            color: white;
            padding: 12px 24px;
            border-radius: 8px;
            box-shadow: var(--shadow);
            font-weight: 500;
            z-index: 100;
            transform: translateY(100px);
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .toast.show {
            transform: translateY(0);
            opacity: 1;
        }

        .toast.error {
            background-color: var(--accent-error);
        }

        /* ショートカットキー案内 */
        .shortcuts-tip {
            display: flex;
            gap: 12px;
        }

        .shortcut-key {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.1);
            padding: 1px 5px;
            border-radius: 4px;
            font-family: var(--font-mono);
            font-size: 0.75rem;
        }

        /* レスポンシブ対応 */
        @media (max-width: 1024px) {
            .main-container {
                grid-template-columns: 1fr;
                grid-template-rows: 1fr 1fr;
            }
            .editor-pane {
                border-right: none;
                border-bottom: 1px solid var(--border-color);
            }
        }
    </style>
</head>
<body>

    <!-- ヘッダー -->
    <header>
        <div class="header-title-area">
            <h1>📝 Markdown 記事エディタ</h1>
            <span class="file-badge">data/articles/<%= shoeId %>.md</span>
            <span class="source-badge">読み込み元: <%= dataFormat %></span>
        </div>
        <div class="header-actions">
            <a href="/shoes/<%= shoeId %>" target="_blank" class="btn btn-secondary">
                👁️ 本番公開ページ
            </a>
            <button id="saveBtn" class="btn btn-primary">
                💾 変更を保存
            </button>
        </div>
    </header>

    <!-- メイン -->
    <main class="main-container">
        <!-- 左側：エディタ -->
        <div class="editor-pane">
            <div class="editor-header">
                <span>編集エリア（Markdown 形式で記述）</span>
                <div class="shortcuts-tip">
                    <span>保存: <span class="shortcut-key">Ctrl + S</span></span>
                </div>
            </div>
            <div class="editor-container">
                <textarea id="markdownEditor" spellcheck="false" placeholder="# 記事タイトル&#10;&#10;ここにレビューを記入してください..."><%= markdownContent %></textarea>
            </div>
        </div>

        <!-- 右側：プレビュー -->
        <div class="preview-pane">
            <div class="preview-header">
                <span>プレビュー（保存後に自動更新）</span>
                <button id="refreshPreviewBtn" style="background:none; border:none; color:var(--text-muted); cursor:pointer; font-size:0.8rem; text-decoration:underline;">
                    再読み込み
                </button>
            </div>
            <iframe id="previewIframe" class="preview-iframe" src="/shoes/<%= shoeId %>"></iframe>
        </div>
    </main>

    <!-- トースト通知 -->
    <div id="toast" class="toast">保存しました！</div>

    <script>
        const editor = document.getElementById('markdownEditor');
        const saveBtn = document.getElementById('saveBtn');
        const previewIframe = document.getElementById('previewIframe');
        const refreshPreviewBtn = document.getElementById('refreshPreviewBtn');
        const toast = document.getElementById('toast');
        const shoeId = '<%= shoeId %>';

        // トースト表示関数
        function showToast(message, isError = false) {
            toast.textContent = message;
            if (isError) {
                toast.classList.add('error');
            } else {
                toast.classList.remove('error');
            }
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }

        // 保存処理
        async function saveArticle() {
            saveBtn.disabled = true;
            saveBtn.textContent = '保存中...';

            try {
                const markdown = editor.value;
                const response = await fetch(`/admin/articles/${encodeURIComponent(shoeId)}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ markdown }),
                });

                const result = await response.json();

                if (response.ok && result.ok) {
                    showToast('💾 記事を正常に保存しました！');
                    // プレビューiframeをリロード
                    previewIframe.contentWindow.location.reload();
                } else {
                    showToast(result.error || '保存に失敗しました。', true);
                }
            } catch (err) {
                console.error(err);
                showToast('通信エラーが発生しました。', true);
            } finally {
                saveBtn.disabled = false;
                saveBtn.textContent = '💾 変更を保存';
            }
        }

        // イベントリスナー
        saveBtn.addEventListener('click', saveArticle);
        refreshPreviewBtn.addEventListener('click', () => {
            previewIframe.contentWindow.location.reload();
        });

        // ショートカットキー (Ctrl + S)
        document.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key === 's') {
                e.preventDefault();
                saveArticle();
            }
        });

        // Tabキー入力のサポート（テキストエリア内でインデントできるようにする）
        editor.addEventListener('keydown', (e) => {
            if (e.key === 'Tab') {
                e.preventDefault();
                const start = editor.selectionStart;
                const end = editor.selectionEnd;
                editor.value = editor.value.substring(0, start) + "\t" + editor.value.substring(end);
                editor.selectionStart = editor.selectionEnd = start + 1;
            }
        });
    </script>
</body>
</html>
