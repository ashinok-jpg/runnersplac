<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= config.metadata.title %></title>
  <style>
    :root{
      --bg: #0b0c10;
      --bg-soft: #121319;
      --card: #151821;
      --text: #e6e8ee;
      --muted: #aab0bd;
      --accent: #6ad1ff;
      --accent-2: #9bffb7;
      --danger: #ff6a8a;
      --ok: #7cf2c6;
      --warn: #ffd166;
      --ring: rgba(106, 209, 255, .35);
      --shadow: 0 10px 30px rgba(0,0,0,.35);
      --radius-xl: 18px;
      --radius: 12px;
      --radius-sm: 10px;
      --fw-bold: 700;
      --fw-medium: 600;
      --gap: 22px;
      --gap-sm: 14px;
      --maxw: 1080px;
      --hero-h:4px;
      --bp: 960px;
    }
    @media (prefers-color-scheme: light){
      :root{
        --bg:#f7f8fb; --bg-soft:#eef1f7; --card:#ffffff; --text:#111827; --muted:#606a7b; --shadow:0 10px 25px rgba(16,24,40,.08);
        --ring: rgba(17, 89, 201, .25);
      }
    }
    *{box-sizing:border-box}
    html,body{margin:0;background:var(--bg);color:var(--text);font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans JP", "Hiragino Kaku Gothic ProN", Meiryo, sans-serif; line-height:1.8}
    a{color:var(--accent)}
    .wrap{max-width:var(--maxw);margin:auto; padding: calc(var(--hero-h) + 12px) 20px 80px; position:relative}
    .hero{position:fixed; top:0; left:0; right:0; transform:translateY(0); transition:transform .28s ease, opacity .2s ease, background .3s ease; background:linear-gradient(to bottom, rgba(255,255,255,0.02), rgba(255,255,255,0)); backdrop-filter:saturate(1.2) blur(8px); z-index:5; border-bottom:1px solid rgba(255,255,255,.06); will-change: transform, opacity}
    .hero-hidden .hero{ transform: translateY(-120%) !important; opacity: 0 !important; pointer-events: none; }
    .hero-inner{max-width:var(--maxw);margin:auto;padding:10px 16px;display:flex;gap:12px;align-items:center;justify-content:space-between}
    .title{font-size:clamp(20px, 3vw, 28px);font-weight:800;letter-spacing:.2px;margin:0}
    .chip{display:inline-flex;gap:8px;align-items:center;padding:6px 10px;background:var(--bg-soft);border:1px solid rgba(255,255,255,.06);border-radius:999px;color:var(--muted);font-size:12px}
    .actions{display:flex;gap:10px}
    .btn{border:1px solid rgba(255,255,255,.12);background:var(--card);color:var(--text);padding:8px 12px;border-radius:999px;cursor:pointer;box-shadow:var(--shadow); font-size:14px;}
    .btn:hover{outline:2px solid var(--ring)}
    .grid{display:grid;gap:var(--gap);grid-template-columns: 1fr}
    .stack{display:grid;gap:var(--gap); max-width:760px; margin:0 auto 0; width:100%}
    @media (max-width: 960px){ .stack{margin-top:12px; padding:0 12px} }
    .card{background:var(--card);border-radius:var(--radius-xl);padding:22px;box-shadow:var(--shadow);border:1px solid rgba(255,255,255,0.06)}
    .card h2{font-size:clamp(18px, 2.2vw, 22px);margin:0 0 8px;font-weight:800}
    .sub{color:var(--muted);font-size:14px;margin:6px 0 0}
    .lead{font-size:18px;line-height:1.9}
    .spec-chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
    .spec{background:linear-gradient(120deg, rgba(106,209,255,.12), rgba(155,255,183,.10));border:1px solid rgba(106,209,255,.3);padding:10px 12px;border-radius:12px;font-weight:600}
    .split{display:grid;gap:var(--gap);grid-template-columns: 1fr 1fr}
    @media (max-width: 780px){.split{grid-template-columns:1fr}}
    .badge{display:inline-flex;align-items:center;gap:8px;padding:6px 10px;border-radius:999px;font-size:12px;font-weight:700}
    .good{background:rgba(124,242,198,.15);border:1px solid rgba(124,242,198,.5);color:#00c58e}
    .bad{background:rgba(255,106,138,.15);border:1px solid rgba(255,106,138,.5);color:#ff6a8a}
    .scores{display:grid;grid-template-columns: 1fr 1fr;gap:14px}
    @media (max-width: 720px){.scores{grid-template-columns:1fr}}
    .score{background:var(--bg-soft);border:1px solid rgba(255,255,255,.06);border-radius:14px;padding:12px 14px}
    .score .label{display:flex;justify-content:space-between;gap:10px;font-weight:700}
    .bar{height:10px;border-radius:999px;background:linear-gradient(90deg, rgba(106,209,255,.25), rgba(155,255,183,.25));overflow:hidden;margin-top:10px}
    .bar>span{display:block;height:100%;width:0%;background:linear-gradient(90deg, var(--accent), var(--accent-2));border-radius:inherit;transition:width .8s ease}
    .compare{display:grid;grid-template-columns: 1fr 1fr;gap:var(--gap)}
    @media (max-width: 900px){.compare{grid-template-columns:1fr}}
    .compare .mini{display:grid;gap:10px}
    .tips{display:grid;gap:var(--gap);grid-template-columns: .65fr .35fr}
    @media (max-width: var(--bp)){.tips{grid-template-columns:1fr}}
    .callout{border-left:4px solid var(--accent);padding-left:16px}
    .kpis{display:grid;gap:10px}
    .kpi{background:var(--bg-soft);padding:12px;border-radius:14px;border:1px solid rgba(255,255,255,.06)}
    .summary{background:linear-gradient( to bottom right, rgba(106,209,255,.10), rgba(155,255,183,.08) );border:1px solid rgba(106,209,255,.35)}
    .hashtags{opacity:.8}
    html{scroll-behavior:smooth}
  </style>
</head>
<body>
  <header class="hero">
    <div class="hero-inner">
      <h1 class="title"><%= config.metadata.title %></h1>
      <div class="actions">
        <% config.metadata.headerChips.forEach(chip => { %>
        <span class="chip" title="<%= chip.title %>"><%= chip.icon %> <%= chip.text %></span>
        <% }) %>
        <button id="themeBtn" class="btn" aria-label="テーマ切替">🌓 テーマ</button>
      </div>
    </div>
  </header>
  
  <div class="wrap">
    <div class="grid">
      <main class="stack">
        <% config.sections.forEach(section => { %>
          <section id="<%= section.id %>" class="card <%= section.cssClass || '' %>">
            <h2><%= section.title %></h2>
            
            <% if (section.type === 'text') { %>
              <% if (Array.isArray(section.content)) { %>
                <% section.content.forEach(paragraph => { %>
                  <p><%= paragraph %></p>
                <% }) %>
              <% } else { %>
                <p><%= section.content %></p>
              <% } %>
              
            <% } else if (section.type === 'spec') { %>
              <p><%= section.content %></p>
              <div class="spec-chips">
                <% section.specs.forEach(spec => { %>
                  <div class="spec"><%= spec.icon %> <%= spec.label %>：<%= spec.value %></div>
                <% }) %>
              </div>
              <% if (section.note) { %>
                <p class="sub"><%= section.note %></p>
              <% } %>
              
            <% } else if (section.type === 'split') { %>
              <div class="split">
                <div class="mini card" style="padding:16px">
                  <span class="badge good"><%= section.good.icon %> <%= section.good.title %></span>
                  <p><%= section.good.content %></p>
                </div>
                <div class="mini card" style="padding:16px">
                  <span class="badge bad"><%= section.bad.icon %> <%= section.bad.title %></span>
                  <p><%= section.bad.content %></p>
                </div>
              </div>
              
            <% } else if (section.type === 'scores') { %>
              <div class="scores" aria-live="polite">
                <% section.items.forEach(item => { %>
                  <div class="score">
                    <div class="label">
                      <span><%= item.label %></span>
                      <span class="val"><%= item.score %>／<%= item.max %></span>
                    </div>
                    <div class="bar"><span data-width="<%= (item.score / item.max * 100) %>"></span></div>
                    <p class="sub"><%= item.comment %></p>
                  </div>
                <% }) %>
              </div>
              
            <% } else if (section.type === 'comparison') { %>
              <div class="compare">
                <% section.items.forEach(item => { %>
                  <div class="mini card">
                    <h3 style="margin:0 0 6px"><%= item.name %></h3>
                    <p><%= item.content %></p>
                  </div>
                <% }) %>
              </div>
              <% if (section.note) { %>
                <p class="sub"><%= section.note %></p>
              <% } %>
              
            <% } else if (section.type === 'tips') { %>
              <div class="tips">
                <div class="callout">
                  <p><%= section.callout %></p>
                </div>
                <div class="kpis">
                  <% section.kpis.forEach(kpi => { %>
                    <div class="kpi"><%= kpi.icon %> <%= kpi.label %>：<%= kpi.value %></div>
                  <% }) %>
                </div>
              </div>
              
            <% } else if (section.type === 'summary') { %>
              <p><%= section.content %></p>
              <p class="summary-100"><strong>要約</strong>：<%= section.summary100 %></p>
              <p class="hashtags"><%= section.hashtags.join(' ') %></p>
            <% } %>
            
            <% if (section.image) { %>
              <img src="<%= section.image %>" alt="<%= section.title %> image" style="max-width:100%; height:auto; margin-top:12px;" />
            <% } %>
          </section>
        <% }) %>
      </main>
    </div>
  </div>

  <script>
    // テーマ切り替え
    const themeBtn = document.getElementById('themeBtn');
    let light = window.matchMedia('(prefers-color-scheme: light)').matches;
    const toggleTheme = () => {
      document.documentElement.style.filter = light ? 'invert(0) hue-rotate(0)' : 'invert(0)';
      document.documentElement.dataset.theme = light ? 'dark' : 'light';
      light = !light;
    };
    themeBtn?.addEventListener('click', toggleTheme);

    // スコアバーアニメーション
    document.querySelectorAll('.bar span').forEach(bar => {
      const width = bar.getAttribute('data-width');
      if (width) {
        requestAnimationFrame(() => {
          bar.style.width = width + '%';
        });
      }
    });

    // ヘッダー高さ設定
    (function(){
      const header = document.querySelector('.hero');
      function applyHeroH(){
        if(!header) return;
        const h = header.offsetHeight || 64;
        document.documentElement.style.setProperty('--hero-h', h + 'px');
      }
      window.addEventListener('load', applyHeroH);
      window.addEventListener('resize', () => { requestAnimationFrame(applyHeroH); });
    })();
  </script>
</body>
</html>