<%- include('partials/header', { current:'home', user, req }) %>

<% const scoreBars = [['クッション', 'cushion'], ['安定性', 'stability'], ['スピード', 'speed']]; %>

<section class="list-hero">
  <div class="container">
    <h1>自分に合う一足を，評価で探す．</h1>
    <p class="page-lead">実走レビューと10項目の評価で，<%= totalCount %>足のランニングシューズを比較できます．</p>

    <form class="list-search" method="GET" action="/home2" role="search">
      <div class="field">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 21l-4.35-4.35M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input class="input" id="q" name="q" placeholder="シューズ名・ブランドで検索" value="<%= q || '' %>" aria-label="シューズ検索">
      </div>
      <button class="btn" type="button" id="openFilters">
        絞り込み<% if (activeFilters && activeFilters.length){ %> <span class="badge"><%= activeFilters.length %></span><% } %>
      </button>
    </form>

    <div class="brand-tabs" aria-label="ブランドで絞り込み">
      <a href="/home2" class="brand-tab <%= !brand ? 'active' : '' %>">すべて</a>
      <% brands.forEach(function(b){ %>
        <a href="/home2?brand=<%= encodeURIComponent(b) %>" class="brand-tab <%= (brand===b) ? 'active' : '' %>"><%= b %></a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section list-section">
  <div class="container">
    <form class="list-bar" method="GET" action="/home2">
      <% Object.entries(keepParams).forEach(function([k, v]){ %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }) %>
      <span class="list-bar__count"><strong><%= shoes.length %></strong> 足</span>
      <label class="list-bar__check">
        <input type="checkbox" name="review" value="1" <%= review ? 'checked' : '' %> data-autosubmit>
        レビュー記事あり
      </label>
      <label class="list-bar__sort">
        並び順
        <select name="sort" data-autosubmit>
          <% [['score','評価が高い順'],['priceAsc','価格が安い順'],['weightAsc','軽い順']].forEach(function([v, label]){ %>
            <option value="<%= v %>" <%= sort===v ? 'selected' : '' %>><%= label %></option>
          <% }) %>
        </select>
      </label>
    </form>

    <% if (!shoes.length) { %>
      <div class="list-empty">
        <p>条件に合うシューズが見つかりませんでした．</p>
        <a class="btn" href="/home2">条件をリセット</a>
      </div>
    <% } %>

    <div class="shoe-grid" id="shoeGrid">
      <% shoes.forEach(function(s, i){ %>
        <article class="shoe-card <%= (i >= 12) ? 'hidden-card' : '' %>">
          <a class="shoe-card__link" href="/shoes/<%= s.slug %>">
            <div class="shoe-card__media">
              <img src="<%= s.image %>" alt="<%= s.brand %> <%= s.name %>" loading="<%= i < 6 ? 'eager' : 'lazy' %>" decoding="async">
              <% if (s.hasArticle) { %><span class="shoe-card__tag">レビュー記事</span><% } %>
            </div>
            <div class="shoe-card__body">
              <div class="shoe-card__title">
                <div>
                  <span class="shoe-card__brand"><%= s.brand %></span>
                  <h3><%= s.name %></h3>
                </div>
                <span class="shoe-card__score" aria-label="総合評価 <%= s.score?.overall ?? '—' %>"><%= typeof s.score?.overall === 'number' ? s.score.overall.toFixed(1) : '—' %></span>
              </div>
              <p class="shoe-card__spec">
                <%= s.price ? '¥' + s.price.toLocaleString() : '価格未定' %><% if (s.weight) { %> ・ <%= s.weight %>g<% } %><% if (s.purpose) { %> ・ <%= s.purpose %><% } %>
              </p>
              <dl class="score-bars">
                <% scoreBars.forEach(function([label, key]){ const v = s.score?.[key]; %>
                  <div>
                    <dt><%= label %></dt>
                    <dd><span class="score-bar"><i style="width:<%= typeof v === 'number' ? v * 20 : 0 %>%"></i></span><b><%= v ?? '—' %></b></dd>
                  </div>
                <% }) %>
              </dl>
            </div>
          </a>
          <button class="wish-btn" type="button" data-shoe-id="<%= String(s.id) %>">購入候補に入れる</button>
        </article>
      <% }) %>
    </div>

    <div class="load-more">
      <button id="loadMoreBtn" class="btn" type="button">さらに表示</button>
    </div>
  </div>
</section>

<% if (blogs.length) { %>
<section class="section blog-section">
  <div class="container">
    <div class="section-head">
      <h2>ランニングブログ</h2>
      <a href="/blog">すべて見る →</a>
    </div>
    <div class="blog-grid"><%- include('partials/blog-cards', { blogs: blogs.slice(0, 3) }) %></div>
  </div>
</section>
<% } %>

<!-- 絞り込み -->
<div id="filtersModal" class="filters-modal" hidden>
  <div class="filters-modal__panel" role="dialog" aria-modal="true" aria-labelledby="filtersTitle">
    <div class="section-head">
      <h2 id="filtersTitle">絞り込み</h2>
      <button class="btn" type="button" id="closeFilters">閉じる</button>
    </div>
    <form method="GET" action="/home2" class="filters-form">
      <label>ブランド<input name="brand" value="<%= brand || '' %>" placeholder="例：ASICS"></label>
      <label>価格の上限（円）<input type="number" name="priceMax" value="<%= priceMax ?? '' %>" min="0"></label>
      <label>重量の上限（g）<input type="number" name="weightMax" value="<%= weightMax ?? '' %>" min="0"></label>
      <label>クッション（以上）<input type="number" name="cushionMin" value="<%= cushionMin ?? '' %>" min="0" max="5" step="0.5"></label>
      <label>安定性（以上）<input type="number" name="stabilityMin" value="<%= stabilityMin ?? '' %>" min="0" max="5" step="0.5"></label>
      <label>スピード（以上）<input type="number" name="speedMin" value="<%= speedMin ?? '' %>" min="0" max="5" step="0.5"></label>
      <div class="filters-form__actions">
        <a class="btn" href="/home2">リセット</a>
        <button class="btn brand" type="submit">この条件で絞り込む</button>
      </div>
    </form>
  </div>
</div>

<script>
  const modal = document.getElementById('filtersModal');
  document.getElementById('openFilters').addEventListener('click', () => { modal.hidden = false; });
  document.getElementById('closeFilters').addEventListener('click', () => { modal.hidden = true; });
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.hidden = true; });

  document.querySelectorAll('[data-autosubmit]').forEach((el) => {
    el.addEventListener('change', () => el.form.submit());
  });

  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('.wish-btn');
    if (!btn) return;

    const r = await fetch('/api/wishlist', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: btn.dataset.shoeId })
    });
    if (r.status === 401) { location.href = '/login'; return; }
    const j = await r.json().catch(() => ({}));
    if (!r.ok || !j.ok) { alert(j.msg || '追加に失敗しました'); return; }
    btn.textContent = '追加済み';
    btn.disabled = true;
  });

  (function () {
    const btn = document.getElementById('loadMoreBtn');
    const hidden = () => document.querySelectorAll('.shoe-card.hidden-card');
    if (!hidden().length) { btn.hidden = true; return; }
    btn.addEventListener('click', () => {
      Array.from(hidden()).slice(0, 12).forEach((el) => el.classList.remove('hidden-card'));
      if (!hidden().length) btn.hidden = true;
    });
  })();
</script>

<%- include('partials/footer') %>
